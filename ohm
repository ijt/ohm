#!/usr/bin/env bash
# Ohm — one window, one page. Thin OS-integration wrapper: everything
# about actually opening/managing windows lives in the C++/Qt daemon
# (app/src/main.cpp). This script just handles install/uninstall, XDG
# default-browser bookkeeping, and the Hyprland/systemd/desktop wiring.

set -euo pipefail

SCRIPT_PATH=$(readlink -f "${BASH_SOURCE[0]}")
SCRIPT_DIR=$(dirname "$SCRIPT_PATH")
# Source builds drop the binary next to this script. Packages install the
# script at /usr/bin/ohm and the binary at /usr/lib/ohm/ohm-bin --
# the ELF must not be named `ohm`, or `ohm uninstall` is treated as a URL.
if [[ -x $SCRIPT_DIR/app/build/ohm-bin ]]; then
  BIN="$SCRIPT_DIR/app/build/ohm-bin"
elif [[ -x $SCRIPT_DIR/../lib/ohm/ohm-bin ]]; then
  BIN="$SCRIPT_DIR/../lib/ohm/ohm-bin"
else
  BIN="/usr/lib/ohm/ohm-bin"
fi
# Quickshell panels (downloads-panel/, shortcuts-panel/) are not binaries --
# they have to be copied into Omarchy's third-party plugin directory for
# Quickshell to discover them, rather than symlinked into ~/.local/bin.
DOWNLOADS_PANEL_SRC="$SCRIPT_DIR/downloads-panel"
SHORTCUTS_PANEL_SRC="$SCRIPT_DIR/shortcuts-panel"

DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/ohm"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
DOWNLOADS_PANEL_DEST="$CONFIG_HOME/omarchy/plugins/ohm-downloads"
SHORTCUTS_PANEL_DEST="$CONFIG_HOME/omarchy/plugins/ohm-shortcuts"

usage() {
  cat <<'EOF'
Usage: ohm [command] [url]

  ohm [url]       Open a page (hands off to the warm daemon if running)
  ohm daemon      Run the persistent Qt/QtWebEngine daemon (systemd)
  ohm install     Bind Super+Shift+Return, autostart daemon
  ohm uninstall   Restore the Chromium keybind, stop daemon
  ohm start|stop|restart|status
  ohm theme       Refresh overlay colors from the Omarchy theme
  ohm --command NAME  Run a palette command (reopen, zoom-in, ...) in the last-focused window
  ohm default     Make Ohm the XDG / Omarchy default browser
  ohm --version   Print version
EOF
}

require_bin() {
  if [[ ! -x $BIN ]]; then
    echo "ohm: $BIN not built yet. Run:" >&2
    echo "  cmake -S $SCRIPT_DIR/app -B $SCRIPT_DIR/app/build && cmake --build $SCRIPT_DIR/app/build" >&2
    exit 1
  fi
}

install_desktop() {
  mkdir -p "$HOME/.local/share/applications"
  # Prefer the packaged desktop template when present; rewrite Exec/Icon for
  # a source-tree install under ~/.local.
  local template=$SCRIPT_DIR/packaging/ohm.desktop
  if [[ -f $template ]]; then
    sed -e "s|^Exec=ohm|Exec=$HOME/.local/bin/ohm|" \
        -e "s|^Icon=ohm|Icon=$SCRIPT_DIR/app/resources/icon.svg|" \
        "$template" >"$HOME/.local/share/applications/ohm.desktop"
  else
    cat >"$HOME/.local/share/applications/ohm.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Ohm
GenericName=Web Browser
Comment=A minimal web browser: one window per page, and Hyprland is the tab bar
Exec=$HOME/.local/bin/ohm %u
Icon=$SCRIPT_DIR/app/resources/icon.svg
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;x-scheme-handler/about;x-scheme-handler/unknown;
StartupNotify=false
StartupWMClass=ohm
EOF
  fi
  command -v update-desktop-database >/dev/null &&
    update-desktop-database "$HOME/.local/share/applications" >/dev/null 2>&1 || true
}

set_mime_default() {
  local desktop=ohm.desktop
  local mime
  for mime in text/html text/xml application/xhtml+xml \
    x-scheme-handler/http x-scheme-handler/https \
    x-scheme-handler/about x-scheme-handler/unknown; do
    xdg-mime default "$desktop" "$mime" >/dev/null 2>&1 || true
  done
}

patch_mimeapps() {
  local file=$HOME/.config/mimeapps.list
  mkdir -p "$HOME/.config"
  python3 - "$file" <<'PY'
from pathlib import Path
import sys
path = Path(sys.argv[1])
text = path.read_text() if path.exists() else "[Default Applications]\n"
repls = (
    "text/html",
    "text/xml",
    "application/xhtml+xml",
    "x-scheme-handler/http",
    "x-scheme-handler/https",
    "x-scheme-handler/about",
    "x-scheme-handler/unknown",
)
if "[Default Applications]" not in text:
    text = "[Default Applications]\n" + text
lines = text.splitlines()
seen = set()
out = []
in_default = False
for line in lines:
    if line.strip() == "[Default Applications]":
        in_default = True
        out.append(line)
        continue
    if line.startswith("[") and line.strip() != "[Default Applications]":
        if in_default:
            for mime in repls:
                if mime not in seen:
                    out.append(f"{mime}=ohm.desktop")
                    seen.add(mime)
        in_default = False
        out.append(line)
        continue
    if in_default and "=" in line and not line.lstrip().startswith("#"):
        key = line.split("=", 1)[0].strip()
        if key in repls:
            out.append(f"{key}=ohm.desktop")
            seen.add(key)
            continue
    out.append(line)
if in_default:
    for mime in repls:
        if mime not in seen:
            out.append(f"{mime}=ohm.desktop")
path.write_text("\n".join(out).rstrip() + "\n")
PY
}

install_default() {
  install_desktop
  patch_mimeapps
  set_mime_default
  env -u BROWSER xdg-settings set default-web-browser ohm.desktop
  route_webapps
}

# omarchy-launch-webapp only honors the default browser when it's on a
# hardcoded Chromium-family list, so with Ohm as default it still opens web
# apps in Chromium. Point Omarchy's web app entries straight at Ohm instead.
# Quotes around the URL are dropped: Exec may only quote whole arguments.
# unroute_webapps undoes this; re-running install catches newly added apps.
route_webapps() {
  local dir=$HOME/.local/share/applications
  [[ -d $dir ]] || return 0
  python3 - "$dir" "$HOME/.local/bin/ohm" <<'PY2'
import re, sys
from pathlib import Path
d, ohm = Path(sys.argv[1]), sys.argv[2]
pat = re.compile(r'^Exec=omarchy-launch-webapp "?([^" ]+)"?$', re.M)
n = 0
for f in d.glob("*.desktop"):
    text = f.read_text()
    new = pat.sub(lambda m: f"Exec={ohm} --app={m.group(1)}", text)
    if new != text:
        f.write_text(new)
        n += 1
if n:
    print(f"Web apps now open in Ohm ({n} updated).")
PY2
}

unroute_webapps() {
  local dir=$HOME/.local/share/applications
  [[ -d $dir ]] || return 0
  python3 - "$dir" "$HOME/.local/bin/ohm" <<'PY2'
import re, sys
from pathlib import Path
d, ohm = Path(sys.argv[1]), sys.argv[2]
pat = re.compile(r'^Exec=' + re.escape(ohm) + r' --app=(\S+)$', re.M)
for f in d.glob("*.desktop"):
    text = f.read_text()
    new = pat.sub(lambda m: f"Exec=omarchy-launch-webapp {m.group(1)}", text)
    if new != text:
        f.write_text(new)
PY2
}

is_default_browser() {
  [[ $(env -u BROWSER xdg-settings get default-web-browser 2>/dev/null) == ohm.desktop ]]
}

# Prompt on stdout; read from /dev/tty so this still works when stdin is a
# pipe (`curl | bash` → install.sh → ./ohm install). `read -p` writes
# the prompt to stderr, and we don't want a missing /dev/tty to dump a
# bash error, so the read itself is allowed to fail.
#
# $1 = prompt, $2 = default if the reply is empty (y or n).
# Returns 0 for yes, 1 for no / no tty.
ask_tty() {
  local prompt=$1
  local default=${2:-n}
  local reply
  printf '%s' "$prompt"
  if ! read -r reply 2>/dev/null </dev/tty; then
    echo
    return 1
  fi
  [[ -z $reply ]] && reply=$default
  case "$reply" in
    [yY]*) return 0 ;;
    *) return 1 ;;
  esac
}

# Ask on first install only -- re-running this to pick up an update
# shouldn't nag someone who already said no. No controlling terminal
# (CI, etc.) is treated as no.
maybe_install_default() {
  local first_install=$1
  if is_default_browser; then
    echo "Ohm is already the default browser."
    route_webapps
    return
  fi
  if [[ $first_install -eq 0 ]]; then
    echo "Super+Shift+B / xdg-open stay on the XDG default. Run \`ohm default\` to change that."
    return
  fi
  if ask_tty "May I make Ohm your default browser? (links and Super+Shift+B) [y/N] " n; then
    install_default
    echo "Thank you — Ohm is now the default browser."
  else
    echo "No worries. Super+Shift+B and links stay as they are. You can run \`ohm default\` later."
  fi
}

scrub_ohm_mime() {
  local file=$HOME/.config/mimeapps.list
  if [[ -f $file ]]; then
    python3 - "$file" <<'PY'
from pathlib import Path
import sys
path = Path(sys.argv[1])
text = path.read_text()
text = text.replace("=ohm.desktop", "=chromium.desktop")
path.write_text(text)
PY
  fi
}

restore_default() {
  unroute_webapps
  scrub_ohm_mime
  env -u BROWSER xdg-settings set default-web-browser chromium.desktop >/dev/null 2>&1 || true
  local mime
  for mime in text/html x-scheme-handler/http x-scheme-handler/https; do
    xdg-mime default chromium.desktop "$mime" >/dev/null 2>&1 || true
  done
}

install_systemd() {
  mkdir -p "$CONFIG_HOME/systemd/user"
  cat >"$CONFIG_HOME/systemd/user/ohm.service" <<EOF
[Unit]
Description=Ohm warm browser daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=$SCRIPT_PATH daemon
Restart=always
RestartSec=2
TimeoutStopSec=8
KillMode=mixed
Environment=HOME=%h
Environment=XDG_RUNTIME_DIR=%t
PassEnvironment=WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE FONTCONFIG_PATH FONTCONFIG_FILE

[Install]
WantedBy=graphical-session.target
EOF
  # No user session (a container, a TTY-only box): the unit is written,
  # there's just nothing to start it yet.
  if ! systemctl --user show-environment >/dev/null 2>&1; then
    echo "ohm: no systemd user session -- ohm.service is installed but not started" >&2
    return
  fi
  systemctl --user daemon-reload
  systemctl --user enable --now ohm.service
}

install_hypr() {
  # Hyprland is what gives Ohm tabs, but a missing config shouldn't stop
  # the rest of the install.
  if [[ ! -d $CONFIG_HOME/hypr ]]; then
    echo "ohm: no ~/.config/hypr -- skipping the Hyprland window rule and keybindings" >&2
    return
  fi
  local dest=$CONFIG_HOME/hypr/ohm.lua
  cp "$SCRIPT_DIR/hypr.lua" "$dest"
  local main=$CONFIG_HOME/hypr/hyprland.lua
  if [[ -f $main ]] && ! grep -q 'require("hypr.ohm")' "$main"; then
    printf '\n-- Ohm page viewer\nrequire("hypr.ohm")\n' >>"$main"
  fi
  local bindings=$CONFIG_HOME/hypr/bindings.lua
  if [[ -f $bindings ]] && ! grep -q 'Ohm' "$bindings"; then
    cat >>"$bindings" <<EOF

-- Ohm: Super+Shift+Return opens a warm page window.
-- Super+Shift+B stays Omarchy's default-browser launcher (Chromium unless you change it).
hl.unbind("SUPER + SHIFT + RETURN")
o.bind("SUPER + SHIFT + RETURN", "Ohm", { launch = "$HOME/.local/bin/ohm" })
hl.unbind("SUPER + SHIFT + Y")
o.bind("SUPER + SHIFT + Y", "YouTube", { launch = "$HOME/.local/bin/ohm https://youtube.com/" })
EOF
  fi
  if command -v hyprctl >/dev/null; then
    hyprctl reload >/dev/null
    hyprctl configerrors || true
  fi
}

install_path() {
  mkdir -p "$HOME/.local/bin"
  ln -sfn "$SCRIPT_PATH" "$HOME/.local/bin/ohm"
}

# Set by install_omarchy_panel when it replaced an installed panel with
# different files. See restart_shell_if_panels_changed.
PANELS_CHANGED=0

install_omarchy_panel() {
  local src=$1 dest=$2 plugin_id=$3 label=$4
  if [[ ! -d $src ]]; then
    echo "ohm: $src not found -- skipping the $label panel" >&2
    return
  fi
  if [[ -d $dest ]] && ! diff -rq "$src" "$dest" >/dev/null 2>&1; then
    PANELS_CHANGED=1
  fi
  mkdir -p "$(dirname "$dest")"
  rm -rf "$dest"
  cp -r "$src" "$dest"
  # Not fatal -- the panel is optional chrome; the rest of Ohm works
  # without Quickshell picking the plugin up (e.g. no Omarchy shell yet).
  if ! command -v omarchy-shell >/dev/null 2>&1 || ! command -v omarchy-plugin-enable >/dev/null 2>&1; then
    return
  fi
  if ! omarchy-shell shell ping >/dev/null 2>&1; then
    echo "ohm: Omarchy shell is not running; the $label panel was copied but not enabled" >&2
    return
  fi
  # rescanPlugins returns before Quickshell finishes the scan (the reload is
  # scheduled with Qt.callLater). Enabling in that window fails with "plugin
  # is not known". Swallowing that left ohm.shortcuts disabled, so Ctrl+?
  # summoned nothing.
  omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
  local i
  for i in $(seq 1 30); do
    if omarchy-shell shell listPlugins 2>/dev/null |
      jq -e --arg id "$plugin_id" 'any(.[]; .id == $id)' >/dev/null; then
      break
    fi
    sleep 0.1
  done
  local err
  if ! err=$(omarchy-plugin-enable "$plugin_id" 2>&1); then
    echo "ohm: could not enable the $label panel ($plugin_id): ${err:-unknown error}" >&2
  fi
}

# A running Omarchy shell keeps serving the panel QML it loaded first, even
# after its own "Local plugin changed, reloading" pass, so an upgraded panel
# only shows up once the shell restarts. Restart it once, and only when an
# already-installed panel actually changed (a fresh install has nothing
# stale loaded). The bar blinks while it comes back.
restart_shell_if_panels_changed() {
  ((PANELS_CHANGED)) || return 0
  command -v omarchy-restart-shell >/dev/null 2>&1 || return 0
  omarchy-shell shell ping >/dev/null 2>&1 || return 0
  echo "ohm: restarting the Omarchy shell to load the updated panels"
  omarchy-restart-shell >/dev/null 2>&1 ||
    echo "ohm: could not restart the Omarchy shell; run omarchy-restart-shell to see the updated panels" >&2
}

install_downloads_panel() {
  install_omarchy_panel "$DOWNLOADS_PANEL_SRC" "$DOWNLOADS_PANEL_DEST" ohm.downloads downloads
}

install_shortcuts_panel() {
  install_omarchy_panel "$SHORTCUTS_PANEL_SRC" "$SHORTCUTS_PANEL_DEST" ohm.shortcuts shortcuts
}

uninstall_omarchy_panels() {
  # Disable first so Quickshell unloads the QML before the files disappear.
  # Deleting a live plugin makes the shell reload it mid-rm and can flash a
  # blank window.
  if command -v omarchy-plugin-disable >/dev/null 2>&1; then
    omarchy-plugin-disable ohm.downloads >/dev/null 2>&1 || true
    omarchy-plugin-disable ohm.shortcuts >/dev/null 2>&1 || true
  fi
  rm -rf "$DOWNLOADS_PANEL_DEST" "$SHORTCUTS_PANEL_DEST"
  if command -v omarchy-shell >/dev/null 2>&1; then
    omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
  fi
}

install_theme_hook() {
  if command -v omarchy >/dev/null; then
    omarchy hook install theme-set "$SCRIPT_DIR/theme-set-hook.sh" >/dev/null 2>&1 || true
  fi
}

# Earlier names of this install: Shinto (until 0.3.0), then ohm-browser for
# every machine-facing name (0.3.0). Carries either over to plain `ohm`:
# data and config move (never copied, never deleted), and the old service,
# command, desktop entry, Hyprland wiring and panels go. Safe to re-run.
# Echoes 1 if an old name was the default browser, so the caller can hand
# that to Ohm once its desktop entry exists.
migrate_old_installs() {
  local was_default=0 old
  for old in shinto ohm-browser; do
    migrate_install_named "$old" && was_default=1
  done
  echo "$was_default"
}

# Returns 0 if `old` was the default browser.
migrate_install_named() {
  local old=$1
  local old_data=${XDG_DATA_HOME:-$HOME/.local/share}/$old
  local was_default=1
  [[ $(env -u BROWSER xdg-settings get default-web-browser 2>/dev/null) == "$old.desktop" ]] &&
    was_default=0

  # Stop the old daemon before its data moves out from under it.
  if [[ -f $CONFIG_HOME/systemd/user/$old.service ]]; then
    systemctl --user disable --now "$old.service" >/dev/null 2>&1 || true
    rm -f "$CONFIG_HOME/systemd/user/$old.service"
    systemctl --user daemon-reload
  fi
  pkill -x "$old-bin" 2>/dev/null || true

  if [[ -d $old_data ]]; then
    mkdir -p "$DATA_HOME"
    local entry name moved=0
    for entry in "$old_data"/* "$old_data"/.[!.]*; do
      [[ -e $entry ]] || continue
      name=$(basename "$entry")
      # The old install.sh clone; install.sh now clones to $DATA_HOME/src.
      [[ $name == src ]] && continue
      if [[ ! -e $DATA_HOME/$name ]]; then
        mv "$entry" "$DATA_HOME/$name"
        moved=1
      fi
    done
    ((moved)) && echo "ohm: moved logins, history and downloads from $old_data to $DATA_HOME" >&2
    # Drop the old clone only if it's clean and isn't what's running now.
    local old_src=$old_data/src
    if [[ -d $old_src/.git && $SCRIPT_DIR != "$old_src"* ]] &&
      [[ -z $(git -C "$old_src" status --porcelain 2>/dev/null) ]]; then
      rm -rf "$old_src"
    fi
    rmdir "$old_data" 2>/dev/null || true
  fi
  if [[ -d $CONFIG_HOME/$old && ! -e $CONFIG_HOME/ohm ]]; then
    mv "$CONFIG_HOME/$old" "$CONFIG_HOME/ohm"
  fi

  # The old command, and older versions' helpers that pointed into the old
  # data directory (shinto-downloads).
  local link
  for link in "$HOME/.local/bin/$old" "$HOME/.local/bin/$old"-*; do
    [[ -L $link ]] && rm -f "$link"
  done
  rm -f "$HOME/.local/share/applications/$old.desktop"
  if [[ -f $HOME/.config/mimeapps.list ]]; then
    sed -i "s/=${old//./\\.}\\.desktop/=ohm.desktop/g" "$HOME/.config/mimeapps.list"
  fi

  if command -v omarchy-plugin-disable >/dev/null 2>&1; then
    omarchy-plugin-disable "$old.downloads" >/dev/null 2>&1 || true
    omarchy-plugin-disable "$old.shortcuts" >/dev/null 2>&1 || true
  fi
  rm -rf "$CONFIG_HOME/omarchy/plugins/$old-downloads" "$CONFIG_HOME/omarchy/plugins/$old-shortcuts"

  # install_hypr then adds Ohm's own lines.
  rm -f "$CONFIG_HOME/hypr/$old.lua"
  if [[ -f $CONFIG_HOME/hypr/hyprland.lua ]]; then
    python3 - "$CONFIG_HOME/hypr/hyprland.lua" "$old" <<'PY'
from pathlib import Path
import sys
p, old = Path(sys.argv[1]), sys.argv[2]
lines = p.read_text().splitlines()
out = []
for line in lines:
    if f'require("hypr.{old}")' in line:
        # Its "-- ... page viewer" comment goes with it.
        if out and out[-1].strip().startswith("--") and "page viewer" in out[-1]:
            out.pop()
        continue
    out.append(line)
if out != lines:
    p.write_text("\n".join(out).rstrip() + "\n")
PY
  fi
  # Shinto's own keybindings; ohm-browser's already launch `ohm`.
  if [[ $old == shinto && -f $CONFIG_HOME/hypr/bindings.lua ]]; then
    python3 - "$CONFIG_HOME/hypr/bindings.lua" <<'PY'
from pathlib import Path
import sys
p = Path(sys.argv[1])
lines = p.read_text().splitlines()
def old(line):
    s = line.strip()
    return (s.startswith("-- Shinto") or "Super+Shift+B stays Omarchy" in s
            or "bin/shinto" in line)
out = []
for line in lines:
    if old(line):
        # The unbind right above an old bind existed only to install it.
        if out and out[-1].lstrip().startswith("hl.unbind("):
            out.pop()
        continue
    out.append(line)
if out != lines:
    p.write_text("\n".join(out).rstrip() + "\n")
PY
  fi
  return "$was_default"
}

do_install() {
  require_bin
  local first_install=1
  # -L too: an old Shinto link may dangle now that its script is renamed.
  [[ -e $HOME/.local/bin/ohm || -L $HOME/.local/bin/shinto ]] && first_install=0
  local was_old_default
  was_old_default=$(migrate_old_installs)
  install_path
  install_downloads_panel
  install_shortcuts_panel
  restart_shell_if_panels_changed
  install_desktop
  install_hypr
  install_systemd
  install_theme_hook
  if ((was_old_default)); then
    install_default
    echo "Ohm is still your default browser."
  fi
  echo "Ohm installed."
  maybe_install_default "$first_install"
  echo "Super+Shift+Return opens Ohm."
  echo "Ctrl+? (or F1) lists keyboard shortcuts."
  echo "Hyprland groups (the tabs): Super+G, Super+Ctrl+Left/Right, Super+Alt+1-4."
}

do_uninstall() {
  systemctl --user disable --now ohm.service 2>/dev/null || true
  rm -f "$CONFIG_HOME/systemd/user/ohm.service"
  rm -f "$HOME/.local/bin/ohm"
  unroute_webapps
  uninstall_omarchy_panels
  rm -f "$HOME/.local/share/applications/ohm.desktop"
  # Unhook before deleting: Hyprland auto-reloads on config changes, and
  # deleting ohm.lua while hyprland.lua still requires it flashed a
  # config-error banner until the require was gone.
  if [[ -f $CONFIG_HOME/hypr/hyprland.lua ]]; then
    python3 - <<'PY'
from pathlib import Path
p = Path.home() / ".config/hypr/hyprland.lua"
lines = p.read_text().splitlines()
out = []
i = 0
while i < len(lines):
    line = lines[i]
    if line.strip() == "-- Ohm page viewer" and i + 1 < len(lines) and "hypr.ohm" in lines[i + 1]:
        i += 2
        continue
    if "hypr.ohm" in line:
        i += 1
        continue
    out.append(line)
    i += 1
p.write_text("\n".join(out).rstrip() + "\n")
PY
  fi
  if [[ -f $CONFIG_HOME/hypr/bindings.lua ]]; then
    python3 - <<'PY'
from pathlib import Path
p = Path.home() / ".config/hypr/bindings.lua"
lines = p.read_text().splitlines()

def ohm_line(line):
    s = line.strip()
    if s.startswith("-- Ohm"):
        return True
    if "Super+Shift+B stays Omarchy" in s:
        return True
    if s == "-- Super+Shift+Return stays Omarchy's default-browser launcher (Chromium).":
        return True
    if "/ohm" in line or "bin/ohm" in line:
        return True
    return False

out = []
for line in lines:
    if ohm_line(line):
        # The unbind immediately above a Ohm bind exists only to install it.
        if out and out[-1].lstrip().startswith("hl.unbind("):
            out.pop()
        continue
    out.append(line)
p.write_text("\n".join(out).rstrip() + "\n")
PY
  fi
  rm -f "$CONFIG_HOME/hypr/ohm.lua"
  scrub_ohm_mime
  if [[ $(env -u BROWSER xdg-settings get default-web-browser 2>/dev/null) == ohm.desktop ]]; then
    restore_default
  fi
  systemctl --user daemon-reload 2>/dev/null || true
  if command -v hyprctl >/dev/null; then
    hyprctl reload >/dev/null || true
  fi
  echo "Ohm uninstalled. Data left in $DATA_HOME"
}

cmd=${1:-}
cmd=${cmd%$'\r'}
cmd=${cmd,,}
case $cmd in
  -h | --help | help)
    usage
    ;;
  daemon)
    require_bin
    exec "$BIN" --daemon
    ;;
  install)
    do_install
    ;;
  uninstall)
    do_uninstall
    ;;
  start)
    systemctl --user start ohm.service
    ;;
  stop)
    systemctl --user stop ohm.service
    ;;
  restart)
    # The warm daemon is systemd's ohm.service, which execs the
    # install-tree wrapper (~/.local/share/ohm/src/ohm daemon), not
    # necessarily this checkout. Copy this tree's freshly built binary
    # over that one (no-op if they're the same file), then bounce the
    # unit so the running process is the new build.
    require_bin
    systemctl --user stop ohm.service 2>/dev/null || true
    pkill -x ohm-bin 2>/dev/null || true
    sleep 0.2
    if pgrep -x ohm-bin >/dev/null; then
      pkill -9 -x ohm-bin || true
      sleep 0.2
    fi
    daemon_wrapper=$(systemctl --user cat ohm.service 2>/dev/null |
      awk '/^ExecStart=/ { sub(/^ExecStart=/, ""); print $1; exit }')
    if [[ -n $daemon_wrapper ]]; then
      daemon_bin="$(dirname "$(readlink -f "$daemon_wrapper")")/app/build/ohm-bin"
      src=$(readlink -f "$BIN")
      if [[ $src != "$(readlink -f "$daemon_bin" 2>/dev/null || true)" ]]; then
        mkdir -p "$(dirname "$daemon_bin")"
        cp -f "$src" "$daemon_bin"
      fi
    fi
    systemctl --user start ohm.service
    ;;
  status)
    systemctl --user status ohm.service --no-pager || true
    ;;
  theme | --theme)
    require_bin
    exec "$BIN" --theme
    ;;
  --daemon)
    require_bin
    exec "$BIN" --daemon
    ;;
  --command)
    # The shortcuts panel's command palette, e.g. `ohm --command reopen`.
    require_bin
    exec "$BIN" --command "${2:-}"
    ;;
  --version)
    require_bin
    exec "$BIN" --version
    ;;
  default)
    install_default
    echo "Ohm is the default browser ($(env -u BROWSER xdg-settings get default-web-browser))."
    ;;
  *)
    # omarchy-launch-browser maps --private to --incognito / --inprivate.
    # The binary also strips these; drop them here so a lone --incognito is
    # not rejected as an unknown flag by the wrapper.
    while [[ ${1:-} == --incognito || ${1:-} == --private || ${1:-} == --inprivate ]]; do
      shift
    done
    # omarchy-launch-webapp passes Chromium's --app=URL (or --app URL).
    # Every Ohm window is already chrome-less, so it's just the page.
    if [[ ${1:-} == --app=* ]]; then
      set -- "${1#--app=}" "${@:2}"
    elif [[ ${1:-} == --app ]]; then
      shift
    fi
    if [[ ${1:-} == --* ]]; then
      usage >&2
      exit 2
    fi
    # Never hand a shell command to the binary. A schemeless word is opened
    # as a URL and QtWebEngine paints a blank white about:blank window.
    page=${1:-}
    case ${page,,} in
      install|uninstall|start|stop|restart|status|default|daemon|theme|help)
        echo "ohm: refusing to open '$page' as a page" >&2
        exit 2
        ;;
    esac
    require_bin
    exec "$BIN" "${1:-}"
    ;;
esac
