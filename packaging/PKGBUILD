# Maintainer: Isaac Turner <ijt@github>
# AUR package for Omarchy's optional-browser path:
#   omarchy-pkg-aur-add ohm-git
# then `omarchy default browser ohm` (once Omarchy lists it).

pkgname=ohm-git
pkgver=0.0.1.r0.g0000000
pkgrel=1
pkgdesc="A minimal web browser for Omarchy: one window per page, and Hyprland is the tab bar"
arch=('x86_64')
url="https://github.com/ijt/ohm-browser"
license=('MIT')
depends=('qt6-base' 'qt6-webengine' 'lua54'
         # ohm-passkey (phone passkeys): D-Bus/BlueZ, hidraw, rp.id checks
         'dbus' 'systemd-libs' 'publicsuffix-list')
optdepends=('bluez: phone passkeys (the phone proves it is nearby over Bluetooth)')
makedepends=('git' 'cmake' 'cargo')
# !lto: makepkg's -flto=auto turns ohm-passkey's C dependencies (ring)
# into GCC LTO bitcode, which rustc's lld (the x86_64 default) can't link.
options=('!lto')
provides=('ohm')
conflicts=('ohm' 'ohm-browser' 'ohm-browser-git' 'shinto' 'shinto-git')
# Earlier names: shinto-git until 0.3.0, ohm-browser-git for 0.3.0.
replaces=('shinto-git' 'ohm-browser-git')
install=ohm-git.install
# Checked out as ohm/: the repo is ohm-browser, everything else is ohm.
source=("ohm::git+https://github.com/ijt/ohm-browser.git")
sha256sums=('SKIP')

pkgver() {
  cd ohm
  git describe --long --tags --abbrev=7 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' \
    || printf "0.0.1.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cmake -S ohm/app -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build --parallel "$(nproc)"
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 ohm/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # Optional Hyprland window rule for source-style installs; Omarchy PR
  # should also tag `ohm` in default/hypr/apps/browser.lua.
  install -Dm644 ohm/hypr.lua "$pkgdir/usr/share/ohm/hypr.lua"
  install -Dm755 ohm/theme-set-hook.sh "$pkgdir/usr/share/ohm/theme-set-hook.sh"
  # Omarchy Quickshell panels (see downloads-panel/, shortcuts-panel/);
  # same "for source-style installs" caveat as hypr.lua above -- only
  # `ohm install` (source-tree) actually registers them with Quickshell.
  cp -r ohm/downloads-panel "$pkgdir/usr/share/ohm/downloads-panel"
  cp -r ohm/shortcuts-panel "$pkgdir/usr/share/ohm/shortcuts-panel"
}
