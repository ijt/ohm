[Desktop Entry]
Type=Application
Name=Ohm
GenericName=Web Browser
Comment=Page viewer for Omarchy — one window, one page
Exec=ohm %u
Icon=ohm-browser
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;x-scheme-handler/about;x-scheme-handler/unknown;
StartupNotify=false
StartupWMClass=ohm-browser
Keywords=Internet;WWW;Browser;Web;Explorer
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=ohm
