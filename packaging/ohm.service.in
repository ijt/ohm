[Unit]
Description=Ohm warm browser daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=@OHM_DAEMON_EXEC@ --daemon
Restart=always
RestartSec=2
TimeoutStopSec=8
KillMode=mixed
Environment=HOME=%h
Environment=XDG_RUNTIME_DIR=%t
PassEnvironment=WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE FONTCONFIG_PATH FONTCONFIG_FILE

[Install]
WantedBy=graphical-session.target
