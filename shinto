#!/usr/bin/env bash
# Shinto — one window, one page. Thin OS-integration wrapper: everything
# about actually opening/managing windows lives in the C++/Qt daemon
# (app/src/main.cpp). This script just handles install/uninstall, XDG
# default-browser bookkeeping, and the Hyprland/systemd/desktop wiring.

set -euo pipefail

SCRIPT_PATH=$(readlink -f "${BASH_SOURCE[0]}")
SCRIPT_DIR=$(dirname "$SCRIPT_PATH")
BIN="$SCRIPT_DIR/app/build/shinto-bin"
# The downloads view (Ctrl+J / the bottom progress bar) is a separate Go
# binary (see downloads-tui/) -- BrowserWindow.cpp finds it on PATH by
# bare name, so it needs its own symlink into ~/.local/bin, same as $BIN.
DOWNLOADS_TUI_BIN="$SCRIPT_DIR/downloads-tui/shinto-downloads"

DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/shinto"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

usage() {
  cat <<'EOF'
Usage: shinto [command] [url]

  shinto [url]       Open a page (hands off to the warm daemon if running)
  shinto daemon      Run the persistent Qt/QtWebEngine daemon (systemd)
  shinto install     Bind Super+Shift+Return, autostart daemon
  shinto uninstall   Restore the Chromium keybind, stop daemon
  shinto start|stop|status
  shinto theme       Refresh overlay colors from the Omarchy theme
  shinto default     Make Shinto the XDG / Omarchy default browser
EOF
}

require_bin() {
  if [[ ! -x $BIN ]]; then
    echo "shinto: $BIN not built yet. Run:" >&2
    echo "  cmake -S $SCRIPT_DIR/app -B $SCRIPT_DIR/app/build && cmake --build $SCRIPT_DIR/app/build" >&2
    exit 1
  fi
}

install_desktop() {
  mkdir -p "$HOME/.local/share/applications"
  # Prefer the packaged desktop template when present; rewrite Exec/Icon for
  # a source-tree install under ~/.local.
  local template=$SCRIPT_DIR/packaging/shinto.desktop
  if [[ -f $template ]]; then
    sed -e "s|^Exec=shinto|Exec=$HOME/.local/bin/shinto|" \
        -e "s|^Icon=shinto|Icon=$SCRIPT_DIR/app/resources/icon.png|" \
        "$template" >"$HOME/.local/share/applications/shinto.desktop"
  else
    cat >"$HOME/.local/share/applications/shinto.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Shinto
GenericName=Web Browser
Comment=Page viewer for Omarchy — one window, one page
Exec=$HOME/.local/bin/shinto %u
Icon=$SCRIPT_DIR/app/resources/icon.png
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;x-scheme-handler/about;x-scheme-handler/unknown;
StartupNotify=false
StartupWMClass=shinto
EOF
  fi
  command -v update-desktop-database >/dev/null &&
    update-desktop-database "$HOME/.local/share/applications" >/dev/null 2>&1 || true
}

set_mime_default() {
  local desktop=shinto.desktop
  local mime
  for mime in text/html text/xml application/xhtml+xml \
    x-scheme-handler/http x-scheme-handler/https \
    x-scheme-handler/about x-scheme-handler/unknown; do
    xdg-mime default "$desktop" "$mime" >/dev/null 2>&1 || true
  done
}

patch_mimeapps() {
  local file=$HOME/.config/mimeapps.list
  mkdir -p "$HOME/.config"
  python3 - "$file" <<'PY'
from pathlib import Path
import sys
path = Path(sys.argv[1])
text = path.read_text() if path.exists() else "[Default Applications]\n"
repls = (
    "text/html",
    "text/xml",
    "application/xhtml+xml",
    "x-scheme-handler/http",
    "x-scheme-handler/https",
    "x-scheme-handler/about",
    "x-scheme-handler/unknown",
)
if "[Default Applications]" not in text:
    text = "[Default Applications]\n" + text
lines = text.splitlines()
seen = set()
out = []
in_default = False
for line in lines:
    if line.strip() == "[Default Applications]":
        in_default = True
        out.append(line)
        continue
    if line.startswith("[") and line.strip() != "[Default Applications]":
        if in_default:
            for mime in repls:
                if mime not in seen:
                    out.append(f"{mime}=shinto.desktop")
                    seen.add(mime)
        in_default = False
        out.append(line)
        continue
    if in_default and "=" in line and not line.lstrip().startswith("#"):
        key = line.split("=", 1)[0].strip()
        if key in repls:
            out.append(f"{key}=shinto.desktop")
            seen.add(key)
            continue
    out.append(line)
if in_default:
    for mime in repls:
        if mime not in seen:
            out.append(f"{mime}=shinto.desktop")
path.write_text("\n".join(out).rstrip() + "\n")
PY
}

install_default() {
  install_desktop
  patch_mimeapps
  set_mime_default
  env -u BROWSER xdg-settings set default-web-browser shinto.desktop
}

is_default_browser() {
  [[ $(env -u BROWSER xdg-settings get default-web-browser 2>/dev/null) == shinto.desktop ]]
}

# Prompt on stdout; read from /dev/tty so this still works when stdin is a
# pipe (`curl | bash` → install.sh → ./shinto install). `read -p` writes
# the prompt to stderr, and we don't want a missing /dev/tty to dump a
# bash error, so the read itself is allowed to fail.
#
# $1 = prompt, $2 = default if the reply is empty (y or n).
# Returns 0 for yes, 1 for no / no tty.
ask_tty() {
  local prompt=$1
  local default=${2:-n}
  local reply
  printf '%s' "$prompt"
  if ! read -r reply </dev/tty 2>/dev/null; then
    echo
    return 1
  fi
  [[ -z $reply ]] && reply=$default
  case "$reply" in
    [yY]*) return 0 ;;
    *) return 1 ;;
  esac
}

# Ask on first install only -- re-running this to pick up an update
# shouldn't nag someone who already said no. No controlling terminal
# (CI, etc.) is treated as no.
maybe_install_default() {
  local first_install=$1
  if is_default_browser; then
    echo "Shinto is already the default browser."
    return
  fi
  if [[ $first_install -eq 0 ]]; then
    echo "Super+Shift+B / xdg-open stay on the XDG default. Run \`shinto default\` to change that."
    return
  fi
  if ask_tty "May I make Shinto your default browser? (links and Super+Shift+B) [y/N] " n; then
    install_default
    echo "Thank you — Shinto is now the default browser."
  else
    echo "No worries. Super+Shift+B and links stay as they are. You can run \`shinto default\` later."
  fi
}

restore_default() {
  local file=$HOME/.config/mimeapps.list
  if [[ -f $file ]]; then
    python3 - "$file" <<'PY'
from pathlib import Path
import sys
path = Path(sys.argv[1])
text = path.read_text()
text = text.replace("=shinto.desktop", "=chromium.desktop")
path.write_text(text)
PY
  fi
  env -u BROWSER xdg-settings set default-web-browser chromium.desktop >/dev/null 2>&1 || true
  local mime
  for mime in text/html x-scheme-handler/http x-scheme-handler/https; do
    xdg-mime default chromium.desktop "$mime" >/dev/null 2>&1 || true
  done
}

install_systemd() {
  mkdir -p "$CONFIG_HOME/systemd/user"
  cat >"$CONFIG_HOME/systemd/user/shinto.service" <<EOF
[Unit]
Description=Shinto warm browser daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=$SCRIPT_PATH daemon
Restart=always
RestartSec=2
TimeoutStopSec=8
KillMode=mixed
Environment=HOME=%h
Environment=XDG_RUNTIME_DIR=%t
PassEnvironment=WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE FONTCONFIG_PATH FONTCONFIG_FILE

[Install]
WantedBy=graphical-session.target
EOF
  systemctl --user daemon-reload
  systemctl --user enable --now shinto.service
}

install_hypr() {
  local dest=$CONFIG_HOME/hypr/shinto.lua
  cp "$SCRIPT_DIR/hypr.lua" "$dest"
  local main=$CONFIG_HOME/hypr/hyprland.lua
  if [[ -f $main ]] && ! grep -q 'require("hypr.shinto")' "$main"; then
    printf '\n-- Shinto page viewer\nrequire("hypr.shinto")\n' >>"$main"
  fi
  local bindings=$CONFIG_HOME/hypr/bindings.lua
  if [[ -f $bindings ]] && ! grep -q 'Shinto' "$bindings"; then
    cat >>"$bindings" <<EOF

-- Shinto: Super+Shift+Return opens a warm page window.
-- Super+Shift+B stays Omarchy's default-browser launcher (Chromium unless you change it).
hl.unbind("SUPER + SHIFT + RETURN")
o.bind("SUPER + SHIFT + RETURN", "Shinto", { launch = "$HOME/.local/bin/shinto" })
hl.unbind("SUPER + SHIFT + Y")
o.bind("SUPER + SHIFT + Y", "YouTube", { launch = "$HOME/.local/bin/shinto https://youtube.com/" })
EOF
  fi
  if command -v hyprctl >/dev/null; then
    hyprctl reload >/dev/null
    hyprctl configerrors || true
  fi
}

install_path() {
  mkdir -p "$HOME/.local/bin"
  ln -sfn "$SCRIPT_PATH" "$HOME/.local/bin/shinto"
}

install_downloads_tui() {
  if [[ -x $DOWNLOADS_TUI_BIN ]]; then
    ln -sfn "$DOWNLOADS_TUI_BIN" "$HOME/.local/bin/shinto-downloads"
  else
    # Not fatal -- downloads still work without this, there's just no
    # Ctrl+J/bottom-bar view for them until Go is available.
    echo "shinto: $DOWNLOADS_TUI_BIN not built -- the downloads view (Ctrl+J," >&2
    echo "  or clicking the bottom progress bar) won't work until you run:" >&2
    echo "    cd $SCRIPT_DIR/downloads-tui && go build -o shinto-downloads ." >&2
    echo "  then re-run: $SCRIPT_PATH install" >&2
  fi
}

install_theme_hook() {
  if command -v omarchy >/dev/null; then
    omarchy hook install theme-set "$SCRIPT_DIR/theme-set-hook.sh" >/dev/null 2>&1 || true
  fi
}

do_install() {
  require_bin
  local first_install=1
  [[ -e $HOME/.local/bin/shinto ]] && first_install=0
  install_path
  install_downloads_tui
  install_desktop
  install_hypr
  install_systemd
  install_theme_hook
  echo "Shinto installed."
  maybe_install_default "$first_install"
  echo "Super+Shift+Return opens Shinto."
  echo "Hyprland groups (the tabs): Super+G, Super+Ctrl+Left/Right, Super+Alt+1-4."
}

do_uninstall() {
  systemctl --user disable --now shinto.service 2>/dev/null || true
  rm -f "$CONFIG_HOME/systemd/user/shinto.service"
  rm -f "$HOME/.local/bin/shinto"
  rm -f "$HOME/.local/bin/shinto-downloads"
  rm -f "$HOME/.local/share/applications/shinto.desktop"
  rm -f "$CONFIG_HOME/hypr/shinto.lua"
  if [[ -f $CONFIG_HOME/hypr/hyprland.lua ]]; then
    python3 - <<'PY'
from pathlib import Path
p = Path.home() / ".config/hypr/hyprland.lua"
text = p.read_text()
needle = "\n-- Shinto page viewer\nrequire(\"hypr.shinto\")\n"
p.write_text(text.replace(needle, "\n"))
PY
  fi
  if [[ -f $CONFIG_HOME/hypr/bindings.lua ]]; then
    python3 - <<'PY'
from pathlib import Path
p = Path.home() / ".config/hypr/bindings.lua"
text = p.read_text()
start = text.find("\n-- Shinto: Super+Shift+Return")
if start != -1:
    p.write_text(text[:start].rstrip() + "\n")
PY
  fi
  if [[ $(env -u BROWSER xdg-settings get default-web-browser 2>/dev/null) == shinto.desktop ]]; then
    restore_default
  fi
  systemctl --user daemon-reload 2>/dev/null || true
  if command -v hyprctl >/dev/null; then
    hyprctl reload >/dev/null || true
  fi
  echo "Shinto uninstalled. Data left in $DATA_HOME"
}

cmd=${1:-}
case $cmd in
  -h | --help | help)
    usage
    ;;
  daemon)
    require_bin
    exec "$BIN" --daemon
    ;;
  install)
    do_install
    ;;
  uninstall)
    do_uninstall
    ;;
  start)
    systemctl --user start shinto.service
    ;;
  stop)
    systemctl --user stop shinto.service
    ;;
  status)
    systemctl --user status shinto.service --no-pager || true
    ;;
  theme | --theme)
    require_bin
    exec "$BIN" --theme
    ;;
  --daemon)
    require_bin
    exec "$BIN" --daemon
    ;;
  default)
    install_default
    echo "Shinto is the default browser ($(env -u BROWSER xdg-settings get default-web-browser))."
    ;;
  *)
    # omarchy-launch-browser maps --private to --incognito / --inprivate.
    # The binary also strips these; drop them here so a lone --incognito is
    # not rejected as an unknown flag by the wrapper.
    while [[ ${1:-} == --incognito || ${1:-} == --private || ${1:-} == --inprivate ]]; do
      shift
    done
    if [[ ${1:-} == --* ]]; then
      usage >&2
      exit 2
    fi
    require_bin
    exec "$BIN" "${1:-}"
    ;;
esac
